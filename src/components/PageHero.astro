---
// Full-width plum hero for every inner page: breadcrumb, big Fraunces H1 with an italic coral accent, the page's own
// first paragraph as the intro, quick links to the other pages in the section, and (only when the page has a real
// photo) the photo in the rounded-arch frame on the right.
import Breadcrumb from './Breadcrumb.astro';
import Img from './Img.astro';
import { accentSplit } from '../lib/titles';

interface Pill {
  label: string;
  href: string;
  current?: boolean;
}
interface Props {
  /** Display title (Title Case, no dashes). */
  title: string;
  /** Use the italic coral accent on the last word(s). Off for patient case titles. */
  accent?: boolean;
  crumbs: { label: string; href?: string }[];
  /** Intro HTML (already inline-rendered). */
  lead?: string;
  pills?: Pill[];
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, accent = true, crumbs, lead, pills = [], image, imageAlt = '' } = Astro.props;
const { plain, accent: accentText } = accent ? accentSplit(title) : { plain: title, accent: '' };
---

<section class="bg-plum text-cream overflow-hidden">
  <div class="container-site pt-10 pb-14 max-md:pb-10">
    <Breadcrumb crumbs={crumbs} />
    <div class:list={['mt-8 grid gap-10 items-center', image && 'lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-16']}>
      <div class="min-w-0">
        <h1 class="max-w-[16ch] [text-wrap:balance]" style="max-width: 18ch">
          {plain}{plain && accentText ? ' ' : ''}{accentText && <em>{accentText}</em>}
        </h1>
        {lead && <p class="mt-6 mb-0 text-[clamp(1.1rem,1.6vw,1.35rem)] leading-[1.6] text-on-plum max-w-[62ch]" set:html={lead} />}
        {
          pills.length > 0 && (
            <nav aria-label="In this section" class="mt-8">
              <ul class="list-none m-0 p-0 flex flex-wrap gap-2.5">
                {pills.map((p) => (
                  <li>
                    <a
                      href={p.href}
                      aria-current={p.current ? 'page' : undefined}
                      class:list={[
                        'inline-flex items-center min-h-[44px] px-[18px] rounded-full text-[15px] font-semibold no-underline border-[1.5px] transition-colors',
                        p.current ? 'bg-coral border-coral text-plum' : 'border-plum-line text-cream hover:border-coral hover:text-cream',
                      ]}
                    >
                      {p.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
      {
        image && (
          <div class="relative w-full max-w-[380px] max-lg:mx-auto aspect-[4/5] overflow-hidden rounded-[190px_190px_8px_8px] bg-on-plum-pink">
            <Img src={image} alt={imageAlt} loading="eager" widths={[380, 760]} sizes="(min-width: 1024px) 380px, 80vw" class="absolute inset-0 w-full h-full object-cover" />
          </div>
        )
      }
    </div>
  </div>
</section>
