---
import home from '../../data/home.json';
import Img from '../Img.astro';
import airport from '../../assets/images/travel/richmond-airlines.webp';
import hotelsImg from '../../assets/images/travel/hotels.webp';

const t = home.travel;
// Real photos from the live Travel pages: Richmond airport terminal and a Richmond hotel.
const images: Record<string, ImageMetadata> = { airport, hotels: hotelsImg };
---

<section class="bg-butter">
  <div class="container-site py-24 max-md:py-14 flex flex-wrap gap-14">
    <div class="flex-[1_1_460px] min-w-0">
      <div class="eyebrow text-[#8A3A26] mb-3.5">{t.eyebrow}</div>
      <h2 class="text-[clamp(1.9rem,4vw,2.875rem)] mb-5">{t.title}</h2>
      <p class="m-0 mb-7 text-[#4A3B2A] text-[18px]">{t.text}</p>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-3.5 mb-[30px]">
        {
          t.cards.map((c) => (
            <div class="bg-cream rounded-[8px] overflow-hidden flex flex-col">
              <Img src={images[c.image]} alt={c.alt} widths={[320, 400]} sizes="(min-width: 640px) 240px, 90vw" class="w-full h-[150px] object-cover" />
              <div class="p-5">
                <div class="eyebrow text-[#8A3A26]">{c.label}</div>
                <div class="font-display text-[21px] mt-1 leading-snug">{c.title}</div>
                <div class="text-ink-soft text-[14px] mt-1">{c.text}</div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={t.primaryCta.href} class="btn btn-primary">{t.primaryCta.label}</a>
        <a href={t.secondaryCta.href} class="btn border-plum text-plum hover:bg-plum hover:text-cream">{t.secondaryCta.label}</a>
      </div>
    </div>
    <div class="flex-[1_1_400px] min-w-0 flex flex-col gap-3.5">
      <div class="bg-plum text-cream rounded-[8px] p-7 max-sm:p-5">
        <h3 class="eyebrow text-on-plum-pink mb-3.5">{t.pack.heading}</h3>
        <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
          {t.pack.items.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="text-coral font-bold">✓</span>{item}</li>)}
        </ul>
      </div>
      <div class="bg-cream rounded-[8px] p-6">
        <h3 class="eyebrow text-[#8A3A26] mb-3">{t.hotels.heading}</h3>
        <ul class="list-none m-0 p-0 flex flex-wrap gap-2 text-[14px]">
          {
            t.hotels.items.map((h) => (
              <li>
                <a href={h.href} target="_blank" rel="noopener" class="bg-blush rounded-full px-3 py-2 min-h-[44px] inline-flex items-center text-ink no-underline hover:bg-blush-2 hover:text-ink">
                  {h.name}<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={t.hotels.more.href} class="inline-block mt-4 font-bold no-underline">{t.hotels.more.label} →</a>
      </div>
    </div>
  </div>
</section>
