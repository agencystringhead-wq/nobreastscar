---
// Text-only link cards. The live site has no photos that belong on these, so there are no image slots.
import home from '../../data/home.json';

type Tone = 'blush' | 'mint' | 'plum' | 'butter' | 'teal';
const tones: Record<Tone, { card: string; text: string; arrow: string }> = {
  blush: { card: 'bg-blush text-ink hover:bg-blush-2', text: 'text-ink-soft', arrow: 'text-brick-deep' },
  mint: { card: 'bg-mint text-ink hover:bg-[#BBDCD3]', text: 'text-[#2E4A47]', arrow: 'text-teal' },
  plum: { card: 'bg-plum-2 text-cream hover:bg-[#4A2B53]', text: 'text-on-plum', arrow: 'text-coral' },
  butter: { card: 'bg-butter text-ink hover:bg-[#F0DDA0]', text: 'text-ink-soft', arrow: 'text-brick-deep' },
  teal: { card: 'bg-teal text-cream hover:bg-[#276560]', text: 'text-mint', arrow: 'text-butter' },
};
---

<section class="bg-cream">
  <div class="container-site pt-[72px] pb-6 max-md:pt-12">
    <ul class="list-none p-0 my-0 grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-4">
      {
        home.links.items.map((t) => {
          const tone = tones[t.tone as Tone];
          return (
            <li class="fade-up flex">
              <a href={t.href} class:list={['no-underline rounded-[8px] p-6 flex flex-col gap-2 min-h-[190px] w-full transition-colors hover:text-inherit', tone.card]}>
                <span class="font-display text-[26px] leading-[1.15]">{t.title}</span>
                <span class:list={['text-[15px]', tone.text]}>{t.text}</span>
                <span aria-hidden="true" class:list={['mt-auto text-[22px] font-bold', tone.arrow]}>→</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
