---
import home from '../../data/home.json';
import Img from '../Img.astro';
import silicone from '../../assets/images/implants/silicon-img.webp';
import saline from '../../assets/images/implants/saline-img.webp';
import ideal from '../../assets/images/implants/ideal-implant-img.webp';

const i = home.implants;
// The three real product images from the live homepage. They are small (about 250px wide), so they are
// shown at their natural size on a white panel rather than stretched.
const images: Record<string, ImageMetadata> = { silicone, saline, ideal };
const tones: Record<string, { card: string; tag: string; text: string }> = {
  blush: { card: 'bg-blush', tag: 'text-brick-deep', text: 'text-ink-soft' },
  mint: { card: 'bg-mint', tag: 'text-teal', text: 'text-[#2E4A47]' },
  butter: { card: 'bg-butter', tag: 'text-[#6B4B00]', text: 'text-ink-soft' },
};
---

<section class="bg-cream">
  <div class="container-site py-24 max-md:py-14">
    <div class="eyebrow text-brick-deep mb-3.5">{i.eyebrow}</div>
    <h2 class="mb-2.5">{i.title}</h2>
    <p class="m-0 mb-10 text-ink-soft text-[18px]">{i.subtitle}</p>

    <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-[18px]">
      {
        i.cards.map((c) => {
          const t = tones[c.tone];
          return (
            <li class="fade-up flex">
              <a href={c.href} class:list={['no-underline text-ink hover:text-ink rounded-[8px] overflow-hidden flex flex-col w-full', t.card]}>
                <div class="bg-white m-3 mb-0 rounded-[6px] h-[190px] flex items-center justify-center">
                  <Img src={images[c.key]} alt={c.alt} widths={[images[c.key].width]} sizes={`${images[c.key].width}px`} class="max-h-[150px] w-auto" />
                </div>
                <div class="p-[22px]">
                  <div class="flex justify-between items-baseline gap-3">
                    <span class="font-display text-[28px]">{c.title}</span>
                    <span class:list={['text-[13px] font-bold', t.tag]}>{c.tag}</span>
                  </div>
                  <div class:list={['text-[15px] mt-1.5', t.text]}>{c.text}</div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-[22px] bg-plum text-cream rounded-[8px] p-8 max-sm:p-6 flex flex-wrap gap-x-12 gap-y-7 items-center">
      <div class="flex-[1_1_300px] min-w-0">
        <div class="eyebrow text-on-plum-pink mb-1.5">{i.lifespan.eyebrow}</div>
        <div class="font-display text-[24px] leading-[1.25]">{i.lifespan.heading}</div>
        <a href={i.lifespan.link.href} class="text-coral hover:text-cream font-bold no-underline inline-block mt-2.5">{i.lifespan.link.label} →</a>
      </div>
      <ul class="flex-[2_1_480px] list-none m-0 p-0 grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-[18px]">
        {
          i.lifespan.stats.map((s) => (
            <li>
              <div class="font-display text-[46px] text-coral leading-none">{s.value}</div>
              <div class="text-on-plum text-[14px] mt-1.5">{s.label}</div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-7 flex flex-wrap items-center gap-2.5">
      <span class="eyebrow text-ink-soft mr-1.5">{i.compareLabel}</span>
      {i.compareLinks.map((l) => <a href={l.href} class="no-underline text-ink hover:text-brick-deep bg-blush rounded-full px-[18px] py-[9px] min-h-[44px] inline-flex items-center text-[15px] font-semibold">{l.label}</a>)}
    </div>
  </div>
</section>
