---
import { site } from '../data/site';
---

<div class="bg-plum text-cream rounded-[8px] p-6">
  <div class="eyebrow text-on-plum-pink mb-2">Internet Consult</div>
  <p class="font-display text-[24px] leading-[1.2] m-0 mb-4">No-cost internet consultation</p>
  <a href="#consult" class="btn btn-primary w-full">Online Consultation</a>
  <a href={site.phoneHref} class="block mt-3 text-center font-display text-[24px] text-on-plum-pink no-underline hover:text-coral">{site.phone}</a>
</div>
