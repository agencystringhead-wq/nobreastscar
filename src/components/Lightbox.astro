---
// A simple lightbox for revealed case-study photos. Photos opt in with <button data-lightbox data-full=... data-alt=...>.
// Keyboard: Esc closes, left and right arrows move between photos. It only opens while the photos are unblurred.
---

<dialog id="lightbox" class="lb" aria-label="Photo viewer">
  <div class="lb-inner">
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close photo viewer">×</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo">‹</button>
    <figure class="lb-figure">
      <img alt="" data-lb-img />
      <figcaption data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Next photo">›</button>
  </div>
</dialog>

<style is:global>
  dialog.lb {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    color: var(--cream);
  }
  dialog.lb::backdrop {
    background: rgb(20 8 24 / 0.92);
  }
  .lb-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 64px;
  }
  .lb-figure {
    margin: 0;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .lb-figure img {
    max-width: 100%;
    max-height: calc(100dvh - 140px);
    width: auto;
    height: auto;
    border-radius: 6px;
    background: #fff;
  }
  .lb-figure figcaption {
    font-size: 14px;
    color: var(--on-plum-soft);
    text-align: center;
  }
  .lb-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1.5px solid var(--plum-line);
    background: var(--plum);
    color: var(--cream);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .lb-btn:hover {
    border-color: var(--coral);
  }
  .lb-close {
    top: 12px;
    right: 12px;
  }
  .lb-prev {
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
  }
  @media (max-width: 640px) {
    .lb-inner {
      padding: 64px 8px 72px;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 12px;
      transform: none;
    }
    .lb-prev {
      left: calc(50% - 56px);
    }
    .lb-next {
      right: calc(50% - 56px);
    }
  }
  [data-lightbox] {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  [data-lightbox][aria-disabled='true'] {
    cursor: default;
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
    let items: HTMLButtonElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const b = items[index];
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt ?? '';
      cap.textContent = `${index + 1} of ${items.length}`;
    };
    const many = () => dlg.querySelectorAll('[data-lb-prev],[data-lb-next]').forEach((el) => ((el as HTMLElement).hidden = items.length < 2));

    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-lightbox]');
      if (!b || b.getAttribute('aria-disabled') === 'true') return;
      const group = b.closest('[data-blur-group]') ?? document;
      items = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-lightbox]'));
      opener = b;
      show(items.indexOf(b));
      many();
      dlg.showModal();
    });
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-lb-close]') || t === dlg || t.classList.contains('lb-inner')) dlg.close();
      else if (t.closest('[data-lb-prev]')) show(index - 1);
      else if (t.closest('[data-lb-next]')) show(index + 1);
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });
    dlg.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
  }
</script>
