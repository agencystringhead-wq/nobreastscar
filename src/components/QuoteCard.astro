---
// A patient quote exactly as on the live reviews/testimonials pages: label, text and (when the live page shows
// one) the source logo.
import Img from './Img.astro';

interface Props {
  label: string;
  text: string;
  logo?: ImageMetadata;
  source?: string | null;
  tone?: 'blush' | 'mint' | 'butter' | 'white';
}
const { label, text, logo, source, tone = 'white' } = Astro.props;
const tones = {
  blush: 'bg-blush',
  mint: 'bg-mint',
  butter: 'bg-butter',
  white: 'bg-white border border-line',
};
// The live quotes end with a stray space before the closing quote mark; only that space is removed.
const paras = text.split('\n\n').map((p) => p.replace(/\s+”$/, '”'));
---

<figure class:list={['m-0 rounded-[8px] p-7 max-sm:p-5 flex flex-col gap-4', tones[tone]]}>
  <blockquote class="m-0 font-display text-[21px] leading-[1.45] text-ink flex flex-col gap-3">
    {paras.map((p) => <p class="m-0">{p}</p>)}
  </blockquote>
  <figcaption class="mt-auto flex items-center justify-between gap-3 text-[14px] text-ink-soft">
    <span class="font-semibold">{label}</span>
    {logo && <Img src={logo} alt={source ?? ''} widths={[logo.width]} sizes={`${logo.width}px`} class="h-auto max-h-[48px] w-auto rounded-[4px]" />}
  </figcaption>
</figure>
