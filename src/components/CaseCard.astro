---
// A case-study card for the gallery grids. The thumbnail is a real patient photo, so it is blurred by default:
// place the card inside <BlurReveal>.
import Img from './Img.astro';
import type { CaseStudy } from '../lib/content';

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const d = study.data;
---

<a href={d.path} class="case-card no-underline text-cream hover:text-cream bg-plum rounded-[8px] overflow-hidden flex flex-col w-full h-full">
  <div class="blur-frame relative bg-[#8E6F86]">
    {
      d.thumbnail && (
        <Img src={d.thumbnail} alt={`Before and after photos: ${d.title}`} widths={[280, 420, 570]} sizes="(min-width: 1024px) 330px, (min-width: 640px) 45vw, 100vw" class="blur-photo block w-full h-auto" />
      )
    }
  </div>
  <div class="py-4 px-[18px] flex flex-col gap-1">
    {d.age && <div class="text-[11px] tracking-[0.14em] uppercase text-on-plum-pink font-bold">Age: {d.age}</div>}
    <h3 class="font-display text-[19px] leading-[1.3] m-0 text-cream">{d.title}</h3>
    <span class="mt-2 text-coral font-bold text-[15px]">View case study →</span>
  </div>
</a>

<style>
  .case-card {
    transition: transform 160ms ease;
  }
  .case-card:hover,
  .case-card:focus-visible {
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-card {
      transition: none;
    }
    .case-card:hover {
      transform: none;
    }
  }
</style>
