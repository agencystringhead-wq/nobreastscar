---
import home from '../../data/home.json';
import reviewData from '../../data/reviews.json';
import Img from '../Img.astro';

// Quotes, labels and sources are taken verbatim from /about/reviews/ by scripts/import-content.mjs.
// The source on the live page is a logo image, so the logo is shown, with the source name as its alt text.
const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/logos/*.webp', { eager: true });
const logoFor = (path: string | null) => (path ? logos[`../../assets/images/logos/${path.split('/').pop()}`]?.default : undefined);

// The live quotes end with a stray space before the closing quote mark; only that space is removed.
const tidy = (s: string) => s.replace(/\s+”$/, '”');

const r = home.reviews;
const featured = reviewData.reviews[r.featuredIndex];
const cards = r.cardIndexes.map((idx, n) => ({ ...reviewData.reviews[idx], tone: r.tones[n] }));
const tones: Record<string, { card: string; cite: string }> = {
  blush: { card: 'bg-blush', cite: 'text-ink-soft' },
  mint: { card: 'bg-mint', cite: 'text-[#2E4A47]' },
  butter: { card: 'bg-butter', cite: 'text-ink-soft' },
  white: { card: 'bg-white border border-line', cite: 'text-ink-soft' },
};
---

<section class="bg-cream">
  <div class="container-site py-24 max-md:py-14">
    <div class="flex flex-wrap justify-between items-end gap-4 mb-10">
      <div>
        <div class="eyebrow text-brick-deep mb-3.5">{r.eyebrow}</div>
        <h2>{r.title}</h2>
      </div>
      <a href={r.link.href} class="font-bold no-underline">{r.link.label} →</a>
    </div>
    <div class="fade-up grid grid-cols-1 md:grid-cols-3 gap-[18px]">
      <figure class="m-0 bg-plum text-cream rounded-[8px] p-8 max-sm:p-6 flex flex-col gap-[18px] md:row-span-2 md:col-start-1">
        <blockquote class="m-0 font-display italic text-[clamp(1.35rem,2.4vw,1.75rem)] leading-[1.35]">{tidy(featured.text)}</blockquote>
        <figcaption class="mt-auto flex items-center justify-between gap-3 text-[14px] text-on-plum-soft">
          <span>{featured.label}</span>
          {logoFor(featured.logo) && <Img src={logoFor(featured.logo)!} alt={featured.source ?? ''} widths={[logoFor(featured.logo)!.width]} sizes={`${logoFor(featured.logo)!.width}px`} class="h-auto max-h-[56px] w-auto rounded-[4px]" />}
        </figcaption>
      </figure>
      {
        cards.map((q) => (
          <figure class:list={['m-0 rounded-[8px] p-7 flex flex-col gap-3.5', tones[q.tone].card]}>
            <blockquote class="m-0 font-display text-[20px] leading-[1.35]">{tidy(q.text)}</blockquote>
            <figcaption class:list={['mt-auto flex items-center justify-between gap-3 text-[14px]', tones[q.tone].cite]}>
              <span>{q.label}</span>
              {logoFor(q.logo) && <Img src={logoFor(q.logo)!} alt={q.source ?? ''} widths={[logoFor(q.logo)!.width]} sizes={`${logoFor(q.logo)!.width}px`} class="h-auto max-h-[44px] w-auto rounded-[4px]" />}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
