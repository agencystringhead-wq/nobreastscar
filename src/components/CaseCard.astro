---
// A case-study card for the gallery grids. The live thumbnail is a before/after composite with a branded header and
// footer, so it is NEVER cropped: natural aspect ratio, width 100%, height auto, on a white panel with 12px padding.
// Below it: the live title, a facts row from what the live page states ("Age 38 · Female · 365cc") and "View case".
// The photo is a real patient photo: it is blurred by the initial CSS (class "blur-photo") until the visitor presses
// "View results" on the surrounding <BlurReveal>.
import Img from './Img.astro';
import { caseLine, type CaseStudy } from '../lib/content';

interface Props {
  study: CaseStudy;
  /** Blurred by default (listing pages). Pass false where the photos are shown clear, such as a case study page. */
  blur?: boolean;
}
const { study, blur = true } = Astro.props;
const d = study.data;
const image = d.thumbnail ?? d.featured;
const line = caseLine(d);
---

<article class="case-card bg-white text-ink rounded-[8px] p-3 flex flex-col w-full border border-line">
  <a href={d.path} tabindex="-1" aria-hidden="true" class="block rounded-[4px] overflow-hidden bg-white">
    <div class:list={[blur && 'blur-frame']}>
      <Img src={image} alt="" widths={[420, 640, 880, 1100]} sizes="(min-width: 900px) 580px, 94vw" class:list={[blur && 'blur-photo', 'block w-full h-auto object-contain']} />
    </div>
  </a>
  <div class="px-3 pt-5 pb-4 flex flex-col gap-2">
    <h3 class="font-display text-[24px] leading-[1.25] m-0 text-plum"><a href={d.path} class="no-underline text-plum hover:text-brick-deep">{d.title}</a></h3>
    {line && <p class="m-0 text-[15px] text-ink-soft">{line}</p>}
    <a href={d.path} class="font-bold text-brick-deep mt-1">View case →<span class="sr-only">: {d.title}</span></a>
  </div>
</article>
