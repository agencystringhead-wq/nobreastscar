---
// Cards linking to a section's child pages: the page's own title and the first lines of its own text.
import Img from './Img.astro';

interface Item {
  href: string;
  title: string;
  excerpt: string;
  image?: ImageMetadata;
}
interface Props {
  items: Item[];
  heading?: string;
}
const { items, heading } = Astro.props;
---

<section class="mt-14">
  {heading && <h2 class="text-[clamp(1.75rem,3vw,2.25rem)] mb-6 text-plum">{heading}</h2>}
  <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fill,minmax(min(260px,100%),1fr))] gap-4">
    {
      items.map((it) => (
        <li class="flex">
          <a href={it.href} class="child-card w-full bg-white border border-line rounded-[8px] overflow-hidden no-underline text-ink hover:text-ink flex flex-col">
            {it.image && <Img src={it.image} alt="" widths={[320, 480]} sizes="(min-width: 1024px) 280px, 90vw" class="w-full h-[150px] object-cover" />}
            <div class="p-5 flex flex-col gap-2 flex-1">
              <h3 class="font-display text-[22px] leading-[1.2] m-0 text-plum">{it.title}</h3>
              <p class="m-0 text-[15px] text-ink-soft">{it.excerpt}</p>
              <span class="mt-auto pt-2 font-bold text-brick text-[15px]">Read more →</span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .child-card {
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }
  .child-card:hover,
  .child-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgb(42 23 48 / 0.14);
  }
  @media (prefers-reduced-motion: reduce) {
    .child-card {
      transition: none;
    }
    .child-card:hover {
      transform: none;
    }
  }
</style>
