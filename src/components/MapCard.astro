---
// Static map card (no Google Maps embed): an SVG sketch linking out to Google Maps for directions.
import { site } from '../data/site';
---

<a href={site.mapsUrl} target="_blank" rel="noopener" class="block no-underline rounded-[8px] overflow-hidden text-cream bg-plum-2 hover:text-cream">
  <svg viewBox="0 0 400 190" role="img" aria-label="Map pin on Stony Point Parkway, Richmond" class="block w-full">
    <path d="M0 130 C80 110 140 140 220 110 S340 80 400 90" fill="none" stroke="#57345F" stroke-width="10"></path>
    <path d="M120 0 L170 190 M260 0 L240 190 M0 55 L400 35" fill="none" stroke="#4A2F52" stroke-width="5"></path>
    <circle cx="232" cy="104" r="22" fill="#EF6B57" opacity="0.3"></circle>
    <circle cx="232" cy="104" r="8" fill="#EF6B57"></circle>
    <text x="248" y="90" font-family="Source Sans 3, sans-serif" font-size="13" fill="#FFF8F2">Stony Point Parkway</text>
  </svg>
  <div class="px-[18px] py-3.5 flex justify-between">
    <span>Get directions<span class="sr-only"> (opens in a new tab)</span></span>
    <span aria-hidden="true" class="text-coral">→</span>
  </div>
</a>
