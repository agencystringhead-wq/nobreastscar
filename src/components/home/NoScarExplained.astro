---
import home from '../../data/home.json';

const e = home.explained;
---

<section class="bg-cream">
  <div class="container-site py-24 max-md:py-14 flex flex-wrap gap-16 max-md:gap-10 items-start">
    <div class="flex-[1_1_380px] min-w-0 lg:sticky lg:top-[120px]">
      <div class="eyebrow text-brick-deep mb-3.5">{e.eyebrow}</div>
      <h2 class="mb-5 [&_em]:text-brick-deep">{e.titleBefore} <em>{e.titleEm}</em></h2>
      <p class="m-0 mb-6 text-ink-soft text-[18px]">{e.intro}</p>
      <div class="bg-blush rounded-[8px] p-[26px] mb-[26px]">
        <h3 class="font-display text-[22px] mb-2 leading-snug">{e.safe.question}</h3>
        <p class="m-0 text-ink-soft">{e.safe.answer}</p>
      </div>
      <a href={e.link.href} class="font-bold no-underline">{e.link.label} →</a>
    </div>

    <ol class="fade-up flex-[1_1_520px] min-w-0 list-none m-0 p-0 flex flex-col gap-3.5">
      {
        e.steps.map((s, i) => (
          <li class="bg-white border border-line rounded-[8px] p-7 max-sm:p-5 flex gap-[22px] max-sm:gap-4">
            <span aria-hidden="true" class="font-display text-[44px] text-coral leading-none min-w-14 max-sm:min-w-10 max-sm:text-[34px]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display text-[24px] mb-1.5 leading-snug">{s.title}</h3>
              <p class="m-0 text-ink-soft">{s.text}</p>
            </div>
          </li>
        ))
      }
      <li class="bg-plum text-cream rounded-[8px] p-7 max-sm:p-5">
        <h3 class="font-display text-[24px] mb-1.5 leading-snug">{e.downside.title}</h3>
        <p class="m-0 text-on-plum">{e.downside.text}</p>
      </li>
    </ol>
  </div>
</section>
