---
// The single "View results" / "Hide" button for a blur group (see BlurReveal).
interface Props {
  showLabel?: string;
  hideLabel?: string;
  notice?: string;
}
const { showLabel = 'View results', hideLabel = 'Hide', notice = 'Photos are blurred. Choose View results to show them.' } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
  <button type="button" class="btn btn-primary" aria-pressed="false" data-reveal-toggle data-show-label={showLabel} data-hide-label={hideLabel}>
    <span data-reveal-label>{showLabel}</span>
  </button>
  <p class="m-0 text-[14px] text-ink-soft" data-blur-notice>{notice}</p>
</div>
