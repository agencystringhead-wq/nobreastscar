---
// One patient case study: only facts the live case study states, the featured image uncropped at the top, then every
// image from the live "Images" section in live order. All photos are blurred until the visitor presses the one
// "View results" button (and open in a lightbox once revealed). The description is shown once.
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import BlurReveal from '../../components/BlurReveal.astro';
import RevealButton from '../../components/RevealButton.astro';
import CaseCard from '../../components/CaseCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import Img from '../../components/Img.astro';
import { studiesInGallery, primaryGallery, galleryLabels, excerpt, mdBlock, mdInline, plain, statedTiming, studies, type CaseStudy } from '../../lib/content';

export async function getStaticPaths() {
  const all = await studies();
  const result = [];
  for (const study of all) {
    const gallery = primaryGallery(study);
    const list = await studiesInGallery(gallery);
    const i = list.findIndex((s) => s.id === study.id);
    // "More cases": the neighbours in the same gallery, wrapping round.
    const others = [...list.slice(i + 1), ...list.slice(0, i)].slice(0, 3);
    result.push({ params: { slug: study.id }, props: { study, gallery, prev: list[i - 1], next: list[i + 1], others } });
  }
  return result;
}

const { study, gallery, prev, next, others } = Astro.props as { study: CaseStudy; gallery: string; prev?: CaseStudy; next?: CaseStudy; others: CaseStudy[] };
const d = study.data;

// The body is "## Case description" and "## Procedure details". The live site often repeats the same sentence in both.
const sectionsMd = Object.fromEntries(
  (study.body ?? '')
    .split(/^## /m)
    .slice(1)
    .map((s) => {
      const [h, ...rest] = s.split('\n');
      return [h.trim().toLowerCase(), rest.join('\n').trim()];
    }),
);
const caseMd = sectionsMd['case description'] ?? '';
const procMd = sectionsMd['procedure details'] ?? '';
const showProc = procMd && plain(procMd) !== plain(caseMd);
const lead = caseMd ? mdInline(caseMd.split(/\n{2,}/)[0]) : undefined;

// Facts: only what the live case study states. "undisclosed" fields are not in the data at all.
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const timing = statedTiming(plain(caseMd + ' ' + procMd));
const facts = [
  { label: 'Age', value: d.age },
  { label: 'Gender', value: d.gender },
  { label: 'Implant size', value: d.implantSize },
  { label: 'Implant type', value: d.implantType && cap(d.implantType) },
  { label: 'Technique', value: d.technique && cap(d.technique) },
  { label: 'Photos taken', value: timing },
].filter((f): f is { label: string; value: string } => Boolean(f.value));

// Featured image first (image 1), then the "Images" section in live order.
const featured = d.featured;
const more = d.images;
const total = 1 + more.length;
const alt = (n: number) => `${d.title}, image ${n}`;

const description = d.description || excerpt(caseMd || procMd, 155);
const galleryHref = `/gallery/${gallery}/`;
const label = galleryLabels[gallery];
const crumbs = [{ label: 'No Breast Scar', href: '/' }, { label: 'Gallery', href: '/gallery/' }, { label, href: galleryHref }, { label: d.title }];
---

<PageLayout
  title={d.title}
  accent={false}
  seoTitle={d.seoTitle}
  description={description}
  path={d.path}
  breadcrumb={crumbs}
  lead={lead}
  sectionPath="/gallery/"
  currentHref={galleryHref}
  cta={{ heading: 'Ready to get started?', text: 'Contact Dr. Lynam today.' }}
>
  {
    facts.length > 0 && (
      <Band tone="cream" tight>
        <dl class="m-0 grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-6">
          {facts.map((f) => (
            <div>
              <dt class="eyebrow text-brick-deep mb-1">{f.label}</dt>
              <dd class="m-0 font-display text-[clamp(1.4rem,2.6vw,2rem)] leading-tight text-plum">{f.value}</dd>
            </div>
          ))}
        </dl>
      </Band>
    )
  }

  <BlurReveal controls={false}>
    <Band tone="blush" id="photos">
      <div class="mb-6"><RevealButton /></div>
      <h2 class="sr-only">Featured image</h2>
      <!-- Natural aspect ratio, never cropped: these are before/after composites. -->
      <div class="blur-frame rounded-[8px] bg-[#8E6F86]">
        <button type="button" data-lightbox data-full={featured.src} data-alt={alt(1)} aria-label={`Open image 1 of ${total}`}>
          <Img src={featured} alt={alt(1)} loading="eager" widths={[480, 800, 1100, 1240]} sizes="(min-width: 1240px) 1192px, 94vw" class="blur-photo block w-full h-auto" />
        </button>
      </div>
    </Band>

    {
      more.length > 0 && (
        <Band tone="cream" id="images">
          <h2 class="text-[clamp(1.9rem,3.6vw,2.75rem)] leading-[1.1] mb-8 text-plum">Images</h2>
          <ul class="list-none m-0 p-0 flex flex-col gap-5">
            {more.map((p, i) => (
              <li class="blur-frame rounded-[8px] bg-[#8E6F86]">
                <button type="button" data-lightbox data-full={p.src} data-alt={alt(i + 2)} aria-label={`Open image ${i + 2} of ${total}`}>
                  <Img src={p} alt={alt(i + 2)} widths={[480, 800, 1100, 1240]} sizes="(min-width: 1240px) 1192px, 94vw" class="blur-photo block w-full h-auto" />
                </button>
              </li>
            ))}
          </ul>
        </Band>
      )
    }
  </BlurReveal>
  <Lightbox />

  <Band tone="blush">
    <div class="max-w-[720px] prose-nb">
      <h2>Case description</h2>
      <Fragment set:html={mdBlock(caseMd)} />
      {
        showProc && (
          <>
            <h2>Procedure details</h2>
            <Fragment set:html={mdBlock(procMd)} />
          </>
        )
      }
    </div>
    <nav class="mt-10 grid sm:grid-cols-2 gap-4" aria-label="Previous and next case study">
      {
        prev ? (
          <a href={prev.data.path} class="block bg-cream rounded-[8px] p-5 no-underline text-ink hover:text-ink hover:bg-white">
            <span class="eyebrow text-brick-deep block mb-1">← Previous case</span>
            <span class="font-display text-[20px] leading-snug">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={next.data.path} class="block bg-cream rounded-[8px] p-5 no-underline text-ink hover:text-ink hover:bg-white sm:text-right">
            <span class="eyebrow text-brick-deep block mb-1">Next case →</span>
            <span class="font-display text-[20px] leading-snug">{next.data.title}</span>
          </a>
        )
      }
    </nav>
    <p class="mt-8 mb-0"><a href={galleryHref} class="font-bold">← Back to the {label} gallery</a></p>
  </Band>

  <Fragment slot="related">
    <Band tone="cream">
      <h2 class="text-[clamp(1.9rem,3.6vw,2.75rem)] leading-[1.1] mb-8 text-plum">More {label.toLowerCase()} cases</h2>
      <BlurReveal>
        <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {others.map((s) => <li class="flex"><CaseCard study={s} /></li>)}
        </ul>
      </BlurReveal>
    </Band>
  </Fragment>
</PageLayout>
