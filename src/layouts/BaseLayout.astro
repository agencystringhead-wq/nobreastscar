---
import '../styles/global.css';
import '../styles/inner.css';
import UtilityBar from '../components/UtilityBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** false on the contact page, which carries the form itself. */
  footerForm?: boolean;
}
const { title, description, footerForm = true } = Astro.props;

// Canonicals always point at the production domain (SPEC §9).
const canonical = new URL(Astro.url.pathname, site.productionUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!Astro.url.pathname.startsWith("/404") && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#2A1730" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <UtilityBar />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter form={footerForm} />
    <MobileActionBar />
    <script>
      // Fade-up on scroll (SPEC §3). Elements opt in with the .fade-up class.
      const items = document.querySelectorAll<HTMLElement>('.fade-up');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
