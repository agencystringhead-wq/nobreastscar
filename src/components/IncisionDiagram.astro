---
interface Props {
  variant: 'armpit' | 'crease' | 'areola';
  /** Dark card variant uses lighter strokes and a coral incision. */
  dark?: boolean;
  /** Adds the nipple dots and the dashed endoscope path used in the "explained" section. */
  detailed?: boolean;
  label: string;
  class?: string;
}
const { variant, dark = false, detailed = false, label, class: className = '' } = Astro.props;
const body = dark ? '#7E6383' : '#B48F8A';
const incision = dark ? '#EF6B57' : '#C2412E';
---

<svg viewBox="0 0 160 140" role="img" aria-label={label} class={className}>
  <path
    d="M10 26 C30 18 50 16 64 10 M150 26 C130 18 110 16 96 10 M30 22 C26 50 28 90 34 136 M130 22 C134 50 132 90 126 136 M36 80 C38 104 70 112 80 96 M124 80 C122 104 90 112 80 96"
    fill="none"
    stroke={body}
    stroke-width="1.2"
    stroke-linecap="round"></path>
  {
    detailed && (
      <>
        <circle cx="58" cy="96" r="1.8" fill={body} />
        <circle cx="102" cy="96" r="1.8" fill={body} />
      </>
    )
  }
  {variant === 'armpit' && <path d="M27 48 Q33 55 30 64" fill="none" stroke={incision} stroke-width="3.6" stroke-linecap="round" />}
  {variant === 'crease' && <path d="M45 105 Q56 111 67 107" fill="none" stroke={incision} stroke-width="3.6" stroke-linecap="round" />}
  {variant === 'areola' && <path d="M51.5 97 A6.5 6.5 0 0 0 64.5 97" fill="none" stroke={incision} stroke-width="3.6" stroke-linecap="round" />}
  {detailed && variant === 'armpit' && <path d="M31 58 C 42 70 50 80 56 88" fill="none" stroke={incision} stroke-width="1" stroke-dasharray="3 3" />}
</svg>
