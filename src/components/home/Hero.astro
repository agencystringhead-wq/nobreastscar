---
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import { site } from '../../data/site';
import Img from '../Img.astro';
// Portrait crop (4:5, 1000x1250) of the live hero photo, made by scripts/make-hero-arch.mjs.
import heroArch from '../../assets/images/hero/hero-woman-arch.webp';

const h = home.hero;
// The case-study count always comes from the collection, never a typed number.
const caseStudyCount = (await getCollection('caseStudies')).length;
const factValue = (v: string) => (v === 'caseStudyCount' ? String(caseStudyCount) : v);
---

<section class="bg-plum text-cream overflow-hidden">
  <div class="container-site pt-20 pb-[72px] max-lg:pt-8 max-md:pb-12 flex flex-wrap gap-14 max-lg:gap-8 items-center">
    <div class="flex-[1_1_520px] min-w-0">
      <div class="inline-flex items-center gap-2.5 eyebrow text-on-plum-pink mb-6">
        <span aria-hidden="true" class="w-7 h-0.5 bg-coral"></span>{h.eyebrow}
      </div>
      <h1 class="mb-7">{h.titleBefore} <em>{h.titleEm}</em></h1>
      {h.paragraphs.map((p, i) => <p class:list={['text-[19px] text-on-plum max-w-[560px] m-0', i === 0 ? 'mb-3.5' : 'mb-[34px]']}>{p}</p>)}
      <div class="flex flex-wrap gap-3">
        <a href={h.primaryCta.href} class="btn btn-primary !px-[30px] !min-h-[52px]">{h.primaryCta.label}</a>
        <a href={site.phoneHref} class="btn btn-ghost !px-[30px] !min-h-[52px]">{site.phone}</a>
      </div>
    </div>

    <!-- Arch with the live hero photo. On phones it sits above the text and the card sits below it. -->
    <div class="flex-[1_1_380px] min-w-0 relative w-full max-w-[460px] max-lg:mx-auto max-lg:order-first">
      <div class="hero-arch relative w-full overflow-hidden bg-on-plum-pink">
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-[46%] bg-coral opacity-35"></div>
        <Img
          src={heroArch}
          alt={h.imageAlt}
          loading="eager"
          widths={[480, 640, 800, 1000]}
          sizes="(min-width: 1024px) 460px, 90vw"
          class="hero-arch-photo"
        />
      </div>
      <div class="hero-card">
        <div class="text-[11px] tracking-[0.14em] uppercase text-brick font-bold mb-1">{h.card.label}</div>
        <div class="font-display text-[19px] leading-[1.25]">{h.card.text}</div>
      </div>
    </div>
  </div>

  <div class="border-t border-plum-2">
    <div class="container-site">
      <ul class="list-none p-0 my-0 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))]">
        {
          h.facts.map((f) => (
            <li class="py-[26px] pr-5 md:pl-5 first:pl-0 md:first:pl-0 border-plum-2 border-b md:border-b-0 md:border-r last:border-0">
              <div class="font-display text-[40px] text-coral leading-none">{factValue(f.value)}</div>
              <div class="text-on-plum text-[15px] mt-1.5">{f.label}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- Global: the <img> is rendered by the Img component, which scoped styles cannot reach. -->
<style is:global>
  /* Phone: about 380px tall, arch-topped. */
  .hero-arch {
    height: 380px;
    border-radius: 300px 300px 8px 8px;
  }
  .hero-arch-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .hero-card {
    position: relative;
    z-index: 3;
    margin: -24px 12px 0;
    max-width: 260px;
    background: var(--cream);
    color: var(--ink);
    border-radius: 8px;
    padding: 16px 18px;
    box-shadow: 0 18px 40px rgb(20 8 24 / 0.35);
  }
  /* Desktop: 4:5 arch, card floating over its bottom-left. */
  @media (min-width: 1024px) {
    .hero-arch {
      height: auto;
      aspect-ratio: 4 / 5;
    }
    .hero-card {
      position: absolute;
      margin: 0;
      left: 12px;
      bottom: -24px;
    }
  }
</style>
