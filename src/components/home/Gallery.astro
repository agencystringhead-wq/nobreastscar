---
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import Img from '../Img.astro';

const g = home.gallery;
// Featured studies: the ones the live site lists on its main gallery page, newest first.
const featured = (await getCollection('caseStudies'))
  .filter((s) => s.data.galleries.includes('breast-enlargement'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section class="bg-plum-2 text-cream" data-gallery>
  <div class="container-site py-24 max-md:py-14">
    <div class="flex flex-wrap justify-between items-end gap-6 mb-8">
      <div class="max-w-[640px]">
        <div class="eyebrow text-on-plum-pink mb-3.5">{g.eyebrow}</div>
        <h2 class="mb-[18px] text-cream">{g.titleBefore} <em>{g.titleEm}</em></h2>
        {g.paragraphs.map((p, idx) => <p class:list={['m-0 text-on-plum text-[18px]', idx === 0 && 'mb-2']}>{p}</p>)}
      </div>
      <button
        type="button"
        class="font-bold bg-cream text-plum border-0 rounded-full px-[26px] py-3.5 cursor-pointer min-h-[48px] hover:bg-blush"
        aria-pressed="false"
        data-reveal-toggle
        data-show-label={g.showLabel}
        data-hide-label={g.hideLabel}
      >
        <span data-reveal-label>{g.showLabel}</span>
      </button>
    </div>

    <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-gallery-grid data-revealed="false">
      {
        featured.map((s) => (
          <li class="flex">
            <a href={s.data.path} class="no-underline text-cream hover:text-cream bg-plum rounded-[8px] overflow-hidden flex flex-col w-full">
              <div class="relative overflow-hidden bg-[#8E6F86]">
                {s.data.thumbnail && (
                  <Img
                    src={s.data.thumbnail}
                    alt={`Before and after photos: ${s.data.title}`}
                    widths={[280, 420, 570]}
                    sizes="(min-width: 1240px) 390px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 100vw"
                    class="gallery-photo block w-full h-auto"
                  />
                )}
              </div>
              <div class="py-4 px-[18px]">
                {s.data.age && <div class="text-[11px] tracking-[0.14em] uppercase text-on-plum-pink font-bold">Age: {s.data.age}</div>}
                <div class="font-display text-[19px] leading-[1.3] mt-1">{s.data.title}</div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 mb-0 text-on-plum-soft text-[14px]" data-blur-notice>{g.blurNotice}</p>

    <div class="mt-8 flex flex-wrap gap-3 items-center">
      <a href={g.cta.href} class="btn btn-primary">{g.cta.label}</a>
      <span class="text-on-plum-soft text-[14px]">{g.note}</span>
    </div>
    <nav aria-label={g.browseLabel} class="mt-6 flex flex-wrap items-center gap-2.5">
      <span class="eyebrow text-on-plum-soft mr-1.5">{g.browseLabel}</span>
      {g.browse.map((b) => <a href={b.href} class="no-underline text-cream hover:text-cream rounded-full px-[18px] py-2.5 min-h-[44px] inline-flex items-center text-[15px] font-semibold border-[1.5px] border-[#7E6383] hover:border-coral">{b.label}</a>)}
    </nav>
  </div>
</section>

<style is:global>
  /* Global (not scoped): the <img> is rendered by the Img component, which scoped styles cannot reach.
     Real patient photos are blurred until the visitor chooses to see them. */
  .gallery-photo {
    filter: blur(18px);
    transform: scale(1.12);
    transition:
      filter 300ms ease,
      transform 300ms ease;
  }
  [data-revealed='true'] .gallery-photo {
    filter: none;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-photo {
      transition: none;
    }
  }
</style>

<script>
  // Blur reveal. Nothing is stored: reloading the page blurs everything again (SPEC §5).
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-gallery-grid]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-reveal-toggle]')!;
    const label = toggle.querySelector<HTMLElement>('[data-reveal-label]')!;
    const notice = root.querySelector<HTMLElement>('[data-blur-notice]');
    toggle.addEventListener('click', () => {
      const reveal = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(reveal));
      grid.dataset.revealed = String(reveal);
      label.textContent = reveal ? toggle.dataset.hideLabel! : toggle.dataset.showLabel!;
      if (notice) notice.hidden = reveal;
    });
  });
</script>
