---
import home from '../../data/home.json';
import { studiesInGallery } from '../../lib/content';
import BlurReveal from '../BlurReveal.astro';
import CaseCard from '../CaseCard.astro';

const g = home.gallery;
// Featured studies: the first six the live site lists on its Breast Enlargement gallery page, in live order.
const featured = (await studiesInGallery('breast-enlargement')).slice(0, 6);
---

<section class="bg-plum-2 text-cream">
  <div class="container-site py-24 max-md:py-14">
    <div class="max-w-[640px] mb-8">
      <div class="eyebrow text-on-plum-pink mb-3.5">{g.eyebrow}</div>
      <h2 class="mb-[18px] text-cream">{g.titleBefore} <em>{g.titleEm}</em></h2>
      {g.paragraphs.map((p, idx) => <p class:list={['m-0 text-on-plum text-[18px]', idx === 0 && 'mb-2']}>{p}</p>)}
    </div>

    <!-- One "View results" button for the whole grid. The photos are blurred by the initial CSS, never by JS. -->
    <BlurReveal class="gallery-blur" showLabel={g.showLabel} hideLabel={g.hideLabel} notice={g.blurNotice}>
      <ul class="list-none m-0 p-0 grid grid-cols-1 min-[900px]:grid-cols-2 gap-[28px] items-start">
        {featured.map((s) => <li><CaseCard study={s} /></li>)}
      </ul>
    </BlurReveal>

    <div class="mt-8 flex flex-wrap gap-3 items-center">
      <a href={g.cta.href} class="btn btn-primary">{g.cta.label}</a>
      <span class="text-on-plum-soft text-[14px]">{g.note}</span>
    </div>
    <nav aria-label={g.browseLabel} class="mt-6 flex flex-wrap items-center gap-2.5">
      <span class="eyebrow text-on-plum-soft mr-1.5">{g.browseLabel}</span>
      {g.browse.map((b) => <a href={b.href} class="no-underline text-cream hover:text-cream rounded-full px-[18px] py-2.5 min-h-[44px] inline-flex items-center text-[15px] font-semibold border-[1.5px] border-[#7E6383] hover:border-coral">{b.label}</a>)}
    </nav>
  </div>
</section>

<style is:global>
  /* The reveal button and its notice sit on the plum band here. */
  .gallery-blur [data-blur-notice] {
    color: var(--on-plum-soft);
  }
</style>
