---
import { site } from '../data/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const formUrl = `https://form.jotform.com/${site.jotformId}`;
---

<!-- Plain iframe embed. The jsform script is deliberately not loaded (SPEC §6). The iframe src is set after the page's
     load event so JotForm's scripts (reCAPTCHA, fonts, about 600 KB) never compete with the first paint; without
     JavaScript the <noscript> copy loads it directly. -->
<div class={className}>
  <iframe
    title={site.jotformTitle}
    data-src={formUrl}
    loading="lazy"
    allow="geolocation; microphone; camera; fullscreen; payment"
    width="100%"
    height="865"
    scrolling="no"
    data-jotform={site.jotformId}
    style="width:100%;height:865px;border:0;display:block"></iframe>
  <noscript>
    <iframe src={formUrl} title={site.jotformTitle} width="100%" height="865" style="width:100%;height:865px;border:0"></iframe>
  </noscript>
  <p class="m-0 mt-3 text-[14px] text-ink-soft">
    Form not loading? Call <a href={site.phoneHref} class="font-bold">{site.phone}</a>
  </p>
</div>

<script>
  // Start loading the form once the page itself has finished loading.
  const startForms = () =>
    document.querySelectorAll<HTMLIFrameElement>('iframe[data-jotform][data-src]').forEach((frame) => {
      frame.src = frame.dataset.src!;
      frame.removeAttribute('data-src');
    });
  const whenIdle = () => ('requestIdleCallback' in window ? window.requestIdleCallback(startForms, { timeout: 1500 }) : window.setTimeout(startForms, 300));
  if (document.readyState === 'complete') whenIdle();
  else window.addEventListener('load', whenIdle, { once: true });

  // Accept only JotForm's own origin and only the "setHeight:<px>:<formId>" message.
  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://form.jotform.com') return;
    if (typeof event.data !== 'string') return;
    const match = /^setHeight:(\d{2,5}):(\d+)$/.exec(event.data);
    if (!match) return;
    const [, px, formId] = match;
    document
      .querySelectorAll<HTMLIFrameElement>(`iframe[data-jotform="${formId}"]`)
      .forEach((frame) => {
        if (frame.contentWindow === event.source) frame.style.height = `${px}px`;
      });
  });
</script>
