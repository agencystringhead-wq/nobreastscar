---
// A case-study card for the gallery grids: the live thumbnail cropped to one consistent 4:3 ratio (centred), the
// live title, the age and implant line when the case states them, and a "View case" link.
import Img from './Img.astro';
import { caseLine, type CaseStudy } from '../lib/content';

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const d = study.data;
const image = d.thumbnail ?? d.featured;
const line = caseLine(d);
---

<a href={d.path} class="case-card no-underline text-cream hover:text-cream bg-plum rounded-[8px] overflow-hidden flex flex-col w-full h-full">
  <div class="relative overflow-hidden bg-[#8E6F86] aspect-[4/3]">
    <Img src={image} alt={`Before and after photos: ${d.title}`} widths={[280, 420, 570]} sizes="(min-width: 1024px) 330px, (min-width: 640px) 45vw, 100vw" class="block w-full h-full object-cover object-center" />
  </div>
  <div class="py-4 px-[18px] flex flex-col gap-1 flex-1">
    {line && <div class="text-[12px] tracking-[0.12em] uppercase text-on-plum-pink font-bold">{line}</div>}
    <h3 class="font-display text-[19px] leading-[1.3] m-0 text-cream">{d.title}</h3>
    <span class="mt-auto pt-2 text-coral font-bold text-[15px]">View case →</span>
  </div>
</a>

<style>
  .case-card {
    transition: transform 160ms ease;
  }
  .case-card:hover,
  .case-card:focus-visible {
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-card {
      transition: none;
    }
    .case-card:hover {
      transform: none;
    }
  }
</style>
