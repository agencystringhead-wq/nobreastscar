---
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import { site } from '../../data/site';
import Placeholder from '../Placeholder.astro';

const h = home.hero;
// The case-study count always comes from the collection. Until the import runs it shows [n].
const caseStudyCount = (await getCollection('caseStudies')).length;
const factValue = (v: string) => (v === 'caseStudyCount' ? (caseStudyCount > 0 ? String(caseStudyCount) : '[n]') : v);
---

<section class="bg-plum text-cream overflow-hidden">
  <div class="container-site pt-20 pb-[72px] max-md:pt-12 max-md:pb-12 flex flex-wrap gap-14 items-center">
    <div class="flex-[1_1_520px] min-w-0">
      <div class="inline-flex items-center gap-2.5 eyebrow text-on-plum-pink mb-6">
        <span aria-hidden="true" class="w-7 h-0.5 bg-coral"></span>{h.eyebrow}
      </div>
      <h1 class="mb-7">{h.titleBefore} <em>{h.titleEm}</em></h1>
      {h.paragraphs.map((p, i) => <p class:list={['text-[19px] text-on-plum max-w-[560px] m-0', i === 0 ? 'mb-3.5' : 'mb-[34px]']}>{p}</p>)}
      <div class="flex flex-wrap gap-3">
        <a href={h.primaryCta.href} class="btn btn-primary !px-[30px] !min-h-[52px]">{h.primaryCta.label}</a>
        <a href={site.phoneHref} class="btn btn-ghost !px-[30px] !min-h-[52px]">{site.phone}</a>
      </div>
    </div>

    <div class="flex-[1_1_420px] min-w-0 relative">
      <Placeholder
        label={h.imagePlaceholder}
        class="aspect-[4/5] max-h-[620px] w-full bg-on-plum-pink text-ink-soft rounded-[300px_300px_8px_8px] overflow-hidden"
      />
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-[46%] bg-coral opacity-35 rounded-b-[8px] pointer-events-none"></div>
      <div class="absolute left-3 bottom-9 max-sm:left-2 bg-cream text-ink rounded-[8px] py-4 px-[18px] max-w-[260px] shadow-[0_18px_40px_rgba(20,8,24,0.35)]">
        <div class="text-[11px] tracking-[0.14em] uppercase text-brick font-bold mb-1">{h.card.label}</div>
        <div class="font-display text-[19px] leading-[1.25]">{h.card.text}</div>
      </div>
    </div>
  </div>

  <div class="border-t border-plum-2">
    <ul class="container-site m-0 list-none grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))]">
      {
        h.facts.map((f) => (
          <li class="py-[26px] pr-5 pl-0 md:pl-5 first:pl-0 border-plum-2 border-b md:border-b-0 md:border-r last:border-0">
            <div class="font-display text-[40px] text-coral leading-none">{factValue(f.value)}</div>
            <div class="text-on-plum text-[15px] mt-1.5">{f.label}</div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
