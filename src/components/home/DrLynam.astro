---
import home from '../../data/home.json';
import Img from '../Img.astro';
import portrait from '../../assets/images/doctor/dr-lynam.webp';
import signature from '../../assets/images/doctor/nlynam-sign.webp';

const d = home.doctor;
---

<section class="bg-cream">
  <div class="container-site py-[104px] max-md:py-14 flex flex-wrap gap-16 max-md:gap-10 items-start">
    <div class="flex-[1_1_340px] max-w-[460px] max-md:max-w-none min-w-0 w-full">
      <!-- The live homepage portrait (transparent cut-out), used only here on the homepage. -->
      <div class="bg-blush rounded-[8px] pt-8 flex justify-center overflow-hidden">
        <Img src={portrait} alt={d.photoAlt} widths={[320, portrait.width]} sizes="(min-width: 640px) 320px, 70vw" class="w-[320px] max-w-[80%] h-auto" />
      </div>
      <div class="mt-4 bg-plum text-cream rounded-[8px] p-[22px]">
        <h3 class="eyebrow text-on-plum-pink mb-2.5">{d.trainingHeading}</h3>
        <ul class="list-none m-0 p-0 flex flex-col gap-2 text-[15px]">
          {d.training.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
    <div class="flex-[1_1_480px] min-w-0">
      <div class="eyebrow text-brick mb-3.5">{d.eyebrow}</div>
      <h2 class="mb-7 [&_em]:text-brick">{d.titleBefore} <em>{d.titleEm}</em></h2>
      <p class="font-display italic font-light text-[clamp(1.25rem,2.2vw,1.5rem)] leading-[1.5] m-0 mb-[22px]">{d.letter[0]}</p>
      <p class="font-display italic font-light text-[clamp(1.25rem,2.2vw,1.5rem)] m-0 mb-[22px]">{d.letter[1]}</p>
      <p class="m-0 mb-1 text-ink-soft">{d.sincerely}</p>
      <!-- Real signature (a JPG on white on the live site), blended into the cream background. -->
      <Img src={signature} alt={d.signatureAlt} widths={[signature.width]} sizes={`${signature.width}px`} class="mb-7 w-[220px] h-auto mix-blend-multiply" />
      <a href={d.link.href} class="font-bold no-underline">{d.link.label} →</a>
    </div>
  </div>
</section>
