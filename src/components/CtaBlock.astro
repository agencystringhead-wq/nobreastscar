---
// The "Ready to start this life changing process?" block that closes many live pages.
import { mdBlock } from '../lib/content';
import { site } from '../data/site';

interface Props {
  heading: string;
  text: string;
}
const { heading, text } = Astro.props;
---

<section class="mt-14 bg-plum text-cream rounded-[8px] p-8 max-sm:p-6">
  <h2 class="text-[clamp(1.75rem,3vw,2.25rem)] mb-3 text-cream">{heading}</h2>
  <div class="text-on-plum text-[18px] max-w-[60ch] [&_p]:m-0 [&_p]:mb-3" set:html={mdBlock(text)} />
  <div class="mt-5 flex flex-wrap gap-3">
    <a href="#consult" class="btn btn-primary">Online Consultation</a>
    <a href={site.phoneHref} class="btn btn-ghost">{site.phone}</a>
  </div>
</section>
