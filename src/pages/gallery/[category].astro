---
// The three gallery category pages: the live intro, then the case studies the live page lists as a full-width photo
// grid (blurred by default), then the other galleries.
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import RichBlocks from '../../components/RichBlocks.astro';
import BlurReveal from '../../components/BlurReveal.astro';
import CaseCard from '../../components/CaseCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import { allPages, studies, studiesInGallery, metaDescription, galleryLabels } from '../../lib/content';
import { parseBody } from '../../lib/blocks';
import { displayTitle } from '../../lib/titles';
import { resolveImage } from '../../lib/images';

export async function getStaticPaths() {
  const pages = await allPages();
  const all = await studies();
  const result = [];
  for (const category of Object.keys(galleryLabels)) {
    result.push({
    params: { category },
    props: {
      category,
      page: pages.find((p) => p.data.path === `/gallery/${category}/`)!,
      // The live order of this gallery page.
      list: await studiesInGallery(category),
      counts: Object.fromEntries(Object.keys(galleryLabels).map((c) => [c, all.filter((s) => s.data.galleries.includes(c as 'breast-lift')).length])),
    },
    });
  }
  return result;
}

const { category, page, list, counts } = Astro.props;
const d = page.data;
const { intro } = parseBody(page.body ?? '');
const firstP = intro.findIndex((b) => b.type === 'p');
const lead = firstP >= 0 ? (intro[firstP] as any).html.replace(/<\/?strong>/g, '') : undefined;
const rest = intro.filter((_, i) => i !== firstP);

// Other galleries, with the live tile image from the Gallery landing page.
const pages = await allPages();
const tiles = new Map((pages.find((p) => p.data.path === '/gallery/')?.data.tiles ?? []).map((t) => [t.href, t.image]));
const others = await Promise.all(
  Object.entries(galleryLabels)
    .filter(([c]) => c !== category)
    .map(async ([c, label]) => ({
      href: `/gallery/${c}/`,
      title: label + ' Gallery',
      meta: `${counts[c]} case studies`,
      image: await resolveImage(tiles.get(`/gallery/${c}/`)),
    })),
);
---

<PageLayout title={displayTitle(d.title)} seoTitle={d.seoTitle} description={metaDescription(d.description, page.body ?? '')} path={d.path} breadcrumb={d.breadcrumb} lead={lead} cta={d.cta}>
  {
    rest.length > 0 && (
      <Band tone="cream" tight>
        <div class="max-w-[720px]">
          <RichBlocks blocks={rest} />
        </div>
      </Band>
    )
  }
  <Band tone="blush" id="cases">
    <BlurReveal>
      <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {list.map((s) => <li class="flex"><CaseCard study={s} /></li>)}
      </ul>
    </BlurReveal>
  </Band>
  <Fragment slot="related">
    <Band tone="cream">
      <h2 class="text-[clamp(1.9rem,3.6vw,2.75rem)] leading-[1.1] mb-8 text-plum">More galleries</h2>
      <CardGrid items={others} />
    </Band>
  </Fragment>
</PageLayout>
