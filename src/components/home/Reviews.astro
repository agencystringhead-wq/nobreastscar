---
import home from '../../data/home.json';

const r = home.reviews;
const tones: Record<string, { card: string; cite: string }> = {
  blush: { card: 'bg-blush', cite: 'text-ink-soft' },
  mint: { card: 'bg-mint', cite: 'text-[#2E4A47]' },
  butter: { card: 'bg-butter', cite: 'text-ink-soft' },
  white: { card: 'bg-white border border-line', cite: 'text-ink-soft' },
};
---

<section class="bg-cream">
  <div class="container-site py-24 max-md:py-14">
    <div class="flex flex-wrap justify-between items-end gap-4 mb-10">
      <div>
        <div class="eyebrow text-brick mb-3.5">{r.eyebrow}</div>
        <h2>{r.title}</h2>
      </div>
      <a href={r.link.href} class="font-bold no-underline">{r.link.label} →</a>
    </div>
    <div class="fade-up grid grid-cols-[repeat(auto-fit,minmax(min(270px,100%),1fr))] gap-[18px]">
      <figure class="m-0 bg-plum text-cream rounded-[8px] p-8 max-sm:p-6 flex flex-col gap-[18px] md:row-span-2">
        <span aria-hidden="true" class="font-display text-[80px] leading-[0.6] text-coral">“</span>
        <blockquote class="m-0 font-display italic text-[30px] leading-[1.25]">{r.featured.text}</blockquote>
        <figcaption class="mt-auto text-[14px] text-on-plum-soft">{r.featured.source}</figcaption>
      </figure>
      {
        r.quotes.map((q) => (
          <figure class:list={['m-0 rounded-[8px] p-7 flex flex-col gap-3.5', tones[q.tone].card]}>
            <blockquote class="m-0 font-display text-[22px] leading-[1.3]">“{q.text}”</blockquote>
            <figcaption class:list={['text-[14px]', tones[q.tone].cite]}>{q.source}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
