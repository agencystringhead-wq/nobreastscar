---
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import data from '../../data/reviews.json';
import { pageByPath, metaDescription } from '../../lib/content';
import { displayTitle } from '../../lib/titles';

const page = (await pageByPath('/about/reviews/'))!;
const d = page.data;
const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/logos/*.webp', { eager: true });
const logoFor = (p: string | null) => (p ? logos[`../../assets/images/logos/${p.split('/').pop()}`]?.default : undefined);
const tones = ['blush', 'mint', 'butter', 'white'] as const;
---

<PageLayout title={displayTitle(d.title)} seoTitle={d.seoTitle} description={metaDescription(d.description, '')} path={d.path} breadcrumb={d.breadcrumb} lead={d.description}>
  <Band tone="cream">
    <h2 class="sr-only">Patient reviews</h2>
    <ul class="list-none m-0 p-0 grid grid-cols-1 md:grid-cols-2 gap-5 items-stretch">
      {
        data.reviews.map((r, i) => (
          <li class="flex [&>figure]:w-full">
            <QuoteCard label={r.label} text={r.text} logo={logoFor(r.logo)} source={r.source} tone={tones[i % tones.length]} />
          </li>
        ))
      }
    </ul>
    <p class="mt-10 mb-0"><a href="/about/testimonials/" class="font-bold">Read patient testimonials →</a></p>
  </Band>
</PageLayout>
